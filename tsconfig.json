{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "libReplacement": true,
    "lib": [
      "dom",
      "esnext"
    ],
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    /* Linting */
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* Decorators */
    "experimentalDecorators": true,
  },
  "include": [
    "src",
    "pages/components/"
  ],
  "exclude": [
    "pages/components/"
  ],
}