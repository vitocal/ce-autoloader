{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "target": "es2025",
    "libReplacement": true,
    "lib": [
      "dom",
      "esnext"
    ],
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    /* Linting */
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* Decorators */
    "experimentalDecorators": true,
    "paths": {
      "react": [
        "./node_modules/preact/compat/"
      ],
      "react/jsx-runtime": [
        "./node_modules/preact/jsx-runtime"
      ],
      "react-dom": [
        "./node_modules/preact/compat/"
      ],
      "react-dom/*": [
        "./node_modules/preact/compat/*"
      ]
    }
  },
  "include": [
    "src",
    "pages/components/",
    "pages/examples/"
  ],
  "exclude": [
    "pages/components/",
    "docs/**",
    "node_modules/**"
  ]
}