{
  "name": "ce-autoloader",
  "version": "0.1.2",
  "description": "A webcomponents auto loader and registry",
  "type": "module",
  "main": "./dist/ce-autoloader.umd.cjs",
  "module": "./dist/ce-autoloader.js",
  "types": "./dist/dist.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dist.d.ts",
      "import": "./dist/ce-autoloader.js",
      "require": "./dist/ce-autoloader.umd.cjs"
    }
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build:vi-components": "vite build --config vite.vi-components.config.js",
    "build:docs": "vite build --config vite.docs.js",
    "build:vendor": "vite build --config vite.vendor.config.js",
    "watch:vi-components": "vite build --config vite.vi-components.config.js --watch",
    "watch:docs": "vite build --config vite.docs.js --watch",
    "serve": "npm run build:vi-components && vite preview --config vite.docs.js ",
    "build": "npm run build:vi-components && vite build",
    "test": "npm run test:headless",
    "test:headless": "node scripts/run-integration-tests.js",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitocal/ce-autoloader.git"
  },
  "keywords": [
    "webcomponents",
    "lazyloader",
    "autoloader",
    "registry",
    "custom-element-registry",
    "wc-autoloader",
    "ce-autoloader"
  ],
  "author": {
    "name": "Vitor Calejuri",
    "email": "vitor.cajuleri@gmail.com",
    "url": "https://www.vical.me"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@google/model-viewer": "^4.3.1",
    "@loadingio/transition.css": "^3.0.0",
    "@nordhealth/components": "^4.26.1",
    "@preact/signals-core": "^1.14.3",
    "@preact/signals-react": "^3.10.2",
    "@r2wc/react-to-web-component": "^2.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/dom-view-transitions": "^1.0.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "buffer": "^6.0.3",
    "canvas-confetti": "^1.9.4",
    "chai": "^6.2.2",
    "cjs-module-lexer": "^2.2.0",
    "globe.gl": "^2.46.1",
    "lit": "^3.3.3",
    "mocha": "^11.7.6",
    "puppeteer": "^25.2.1",
    "qrcode-pix": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remount": "^1.0.0",
    "syntax-highlight-element": "^1.2.0",
    "three.js": "^0.77.1",
    "view-transitions-toolkit": "^1.0.0",
    "vite": "^8.1.0",
    "vite-import-maps": "^0.2.6",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-web-components-hmr": "^0.1.3",
    "vue": "^3.5.39"
  }
}
