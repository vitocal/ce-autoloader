{
  "name": "ce-autoloader",
  "version": "0.2.0",
  "description": "A web-component registry that loads async",
  "type": "module",
  "main": "./dist/ce-autoloader.js",
  "module": "./dist/ce-autoloader.js",
  "types": "./dist/index.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ce-autoloader.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "vite dev --config vite.docs.js",
    "build:docs": "vite build --config vite.docs.js",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "importmap": "node scripts/build-importmap.js",
    "test": "npm run test:headless",
    "test:headless": "node scripts/run-integration-tests.js",
    "test:all": "node scripts/run-integration-tests.js --browser=all",
    "test:chromium": "node scripts/run-integration-tests.js --browser=chromium",
    "test:chrome": "node scripts/run-integration-tests.js --browser=chrome",
    "test:safari": "node scripts/run-integration-tests.js --browser=safari",
    "test:edge": "node scripts/run-integration-tests.js --browser=edge",
    "test:firefox": "node scripts/run-integration-tests.js --browser=firefox",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitocal/ce-autoloader.git"
  },
  "homepage": "https://vitocal.github.io/ce-autoloader/",
  "bugs": {
    "url": "https://github.com/vitocal/ce-autoloader/issues"
  },
  "keywords": [
    "webcomponents",
    "lazyloader",
    "autoloader",
    "registry",
    "custom-element-registry",
    "wc-autoloader",
    "ce-autoloader"
  ],
  "author": {
    "name": "Vitor Calejuri",
    "email": "vitor.cajuleri@gmail.com",
    "url": "https://www.vical.me"
  },
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@google/model-viewer": "^4.3.1",
    "@jspm/generator": "^2.17.0",
    "@loadingio/transition.css": "^3.0.0",
    "@nordhealth/components": "^5.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals-core": "^1.14.4",
    "@preact/signals-react": "^3.10.3",
    "@r2wc/react-to-web-component": "^2.1.1",
    "@stencil-community/unplugin-stencil": "^0.5.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/lib-dom": "npm:@types/web@latest",
    "@vitejs/plugin-vue": "^6.0.7",
    "buffer": "^6.0.3",
    "canvas-confetti": "^1.9.4",
    "chai": "^6.2.2",
    "cjs-module-lexer": "^2.2.0",
    "globe.gl": "^2.46.1",
    "lit": "^3.3.3",
    "mocha": "^11.7.6",
    "playwright": "^1.64.0",
    "preact-custom-element": "^4.6.0",
    "qrcode-pix": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remount": "^1.0.0",
    "shadow-observer": "^0.1.7",
    "syntax-highlight-element": "^1.2.0",
    "tailwindcss": "^4.3.3",
    "three.js": "^0.77.1",
    "typescript": "^6.0.3",
    "view-transitions-toolkit": "^1.0.0",
    "vite": "^8.1.3",
    "vite-import-maps": "^0.2.6",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-static-copy": "^4.1.1",
    "vue": "^3.5.39",
    "web-vitals": "^6.2.3"
  },
  "peerDependencies": {
    "shadow-observer": "^0.1.7"
  },
  "peerDependenciesMeta": {
    "shadow-observer": {
      "optional": true
    }
  }
}
